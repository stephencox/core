<form>
    <field>
        <id>schedule</id>
        <label>Schedule</label>
        <type>text</type>
        <readonly>true</readonly>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>timerange.position</id>
        <label>Weekdays</label>
        <help>Choose weekdays or calendar dates. Selecting one clears the other.</help>
        <type>select_multiple</type>
        <grid_view>
            <formatter>weekdays</formatter>
        </grid_view>
    </field>
    <field>
        <id>editor.dates</id>
        <label>Calendar dates</label>
        <type>text</type>
        <help>Select one or more dates. These dates repeat every year.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>timerange.month</id>
        <label>Months</label>
        <type>text</type>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>timerange.day</id>
        <label>Calendar dates</label>
        <type>text</type>
        <grid_view>
            <formatter>dates</formatter>
            <sortable>false</sortable>
        </grid_view>
    </field>
    <field>
        <id>editor.start</id>
        <label>Start time</label>
        <type>dropdown</type>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>editor.stop</id>
        <label>End time</label>
        <type>dropdown</type>
        <help>The end time is exclusive. For an overnight period, add a separate range for each day.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>timerange.hour</id>
        <label>Time range</label>
        <type>text</type>
        <grid_view>
            <formatter>text</formatter>
        </grid_view>
    </field>
    <field>
        <id>timerange.rangedescr</id>
        <label>Description</label>
        <type>text</type>
        <grid_view>
            <formatter>text</formatter>
        </grid_view>
    </field>
</form>
